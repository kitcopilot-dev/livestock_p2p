# ------------------------------------------------------------------
# Livestock Marketplace — environment template
# Copy to `.env` at the repository root for local development.
# Production secrets are injected by the deployment platform instead.
# ------------------------------------------------------------------

# --- Database (local docker-compose defaults) ---
# host port 55432: a native Postgres service owns 5432 on some dev machines
DATABASE_URL="postgresql://livestock:livestock@localhost:55432/livestock?schema=public"

# --- Redis (BullMQ) ---
# host port 6380 (6379 may be taken by other local projects)
REDIS_URL="redis://localhost:6380"

# --- Payment rails ---
# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PLATFORM_ACCOUNT_ID="acct_..."           # platform account that holds the FBO balance
# Dwolla
DWOLLA_ENV="sandbox"                            # sandbox | production
DWOLLA_KEY="..."
DWOLLA_SECRET="..."
DWOLLA_WEBHOOK_SECRET="..."
DWOLLA_PLATFORM_FUNDING_SOURCE_URL="https://api-sandbox.dwolla.com/funding-sources/..."
# Which rail to prefer when both parties support multiple rails
PAYMENT_RAIL_DEFAULT="STRIPE"                   # STRIPE | DWOLLA

# --- Partner integrations (Truepic, OCR, vet telehealth) ---
PARTNER_WEBHOOK_SECRET="hmac-secret-shared-with-partners"

# --- Data-at-rest encryption (AES-256-GCM, 32-byte key, base64) ---
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY="change-me-32-bytes-base64"

# --- KYC provider ---
KYC_PROVIDER_API_KEY="..."

# Simulate the payment rails locally (no Stripe/Dwolla keys needed).
# Set to false and configure rail keys for real transfers.
PAYMENTS_DRY_RUN=true

# --- Feature flags ---
# Re-enable standalone freight posting (post-a-load, My postings, all open loads)
FEATURE_STANDALONE_FREIGHT=false

# Auth: demo | password | magic_link | oauth
AUTH_METHOD=demo
AUTH_SECRET=change-me-in-production
APP_URL=http://localhost:3000
EMAIL_PROVIDER=console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
